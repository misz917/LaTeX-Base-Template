{
    "name": "LaTeX Development",
    "image": "texlive/texlive:latest",
    "customizations": {
        "vscode": {
            "extensions": [
                "valentjn.vscode-ltex",
                "mathematic.vscode-latex",
                "James-Yu.latex-workshop"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "latex-workshop.latex.autoBuild.run": "onSave",
                "latex-workshop.latex.recipe.default": "latexmk",
                "latex-workshop.view.pdf.viewer": "tab"
            }
        }
    },
    "postCreateCommand": "apt-get update && apt-get install -y ssh",
    "containerEnv": {
        "GIT_AUTHOR_NAME": "Your Name",
        "GIT_AUTHOR_EMAIL": "you@example.com",
        "GIT_COMMITTER_NAME": "Your Name",
        "GIT_COMMITTER_EMAIL": "you@example.com"
    },
    "remoteUser": "root"
    // ,
    // "mounts": [
    //     "source=${localEnv:HOME}/.ssh/id_ed25519.pub,target=/root/.ssh/id_ed25519.pub,type=bind,readonly",
    //     "source=${localEnv:HOME}/.ssh/id_ed25519,target=/root/.ssh/id_ed25519,type=bind,readonly"
    // ]
}